#!/usr/bin/env bash

set -u

# The distributable artifact is the .aed package, not the wrapped application,
# so a bare ./build produces both: result for `./run` and local play, result-aed
# for the Aedicule demo manifest.
case "${1:-}" in
	"")
		nix build -o result || exit $?
		exec nix build .#aed -o result-aed
		;;
	--aed)
		exec nix build .#aed -o result-aed
		;;
	--test)
		exec ./test
		;;
	--debug)
		printf '%s\n' 'WAT has no separate debug build; running the complete application checks.' >&2
		exec ./test
		;;
	*)
		printf 'usage: %s [--aed|--test|--debug]\n' "$0" >&2
		exit 2
		;;
esac
