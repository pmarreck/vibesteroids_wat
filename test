#!/usr/bin/env bash

set -u

if [[ ${VIBESTEROIDS_WAT_TEST_SHELL:-0} != 1 ]]; then
	develop=(nix develop --ignore-environment --keep HOME)
	if [[ -n ${TMPDIR:-} ]]; then
		develop+=(--keep TMPDIR)
	fi
	exec "${develop[@]}" -c env VIBESTEROIDS_WAT_TEST_SHELL=1 "$0" "$@"
fi

failures=0

run_check() {
	"$@"
	status=$?
	if (( status != 0 )); then
		printf 'check failed (%d):' "$status" >&2
		printf ' %q' "$@" >&2
		printf '\n' >&2
		failures=$((failures + 1))
	fi
}

repository_checks=(
	./tests/cli/development_dependencies
	./tests/cli/repository_boundary
	./tests/cli/naming_conventions
	./tests/cli/abi_namespace
	./tests/cli/aedicule_abi_contract
	./tests/cli/circle_argument_roles
	./tests/cli/application_package_layout
	./tests/cli/flake_composition
	./tests/cli/run_from_any_directory
	./tests/cli/aedicule_runtime_portability
	./tests/cli/run_wast_diagnostics
)
flake_proved_checks=(
	./tests/cli/aedicule_runtime
	./tests/cli/application_derivation_layout
	./tests/run-wast
	./tests/lint-wat
)
checks=("${repository_checks[@]}")
if [[ ${VIBESTEROIDS_WAT_FLAKE_CHECKED:-0} != 1 ]]; then
	checks+=("${flake_proved_checks[@]}")
fi

for check in "${checks[@]}"; do
	run_check "$check"
done

shell_scripts=(
	build
	run
	test
	"${repository_checks[@]}"
	"${flake_proved_checks[@]}"
	tests/compose-wast
	tests/fixtures/run-bin/nix
	tests/fixtures/runtime-bin/nix
	tests/fixtures/wast-bin/awk
	tests/fixtures/wast-bin/wasmtime
	tests/integration/aedicule_touch_timeline
)
run_check shellcheck "${shell_scripts[@]}"

if (( failures > 255 )); then
	exit 255
fi
exit "$failures"
