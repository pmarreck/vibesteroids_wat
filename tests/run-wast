#!/usr/bin/env bash

set -u

root=$(cd "$(dirname "$0")/.." && pwd)
suite=$(mktemp "$TMPDIR/vibesteroids-aedicule.XXXXXX.wast")
trap 'rm -f "$suite"' EXIT

awk '1' \
	"$root/tests/wast/host-v0.wast" \
	"$root/code.wat" \
	<(printf '%s\n' '(register "sut")') \
	"$root/tests/wast/vibesteroids.wast" \
	"$root/tests/wast/gameplay.wast" >"$suite"

wasmtime wast --async=false "$suite"
