#!/usr/bin/env bash

set -u

root=$(cd "$(dirname "$0")/.." && pwd)

awk '
	/;; FLOAT ADAPTER BEGIN/ {
		if (adapter) {
			print "nested float adapter marker" > "/dev/stderr"
			errors++
		}
		adapter = 1
		seen_begin++
		next
	}
	/;; FLOAT ADAPTER END/ {
		if (!adapter) {
			print "float adapter end marker has no start" > "/dev/stderr"
			errors++
		}
		adapter = 0
		seen_end++
		next
	}
	{
		line = $0
		while (match(line, /f32\.[a-z0-9_]+/)) {
			op = substr(line, RSTART, RLENGTH)
			if ((!adapter && op != "f32.const") || op == "f32.load" || op == "f32.store") {
				printf "forbidden gameplay float opcode at line %d: %s\n", NR, op > "/dev/stderr"
				errors++
			}
			line = substr(line, RSTART + RLENGTH)
		}
	}
	END {
		if (adapter || seen_begin != 1 || seen_end != 1) {
			print "expected exactly one closed float adapter region" > "/dev/stderr"
			errors++
		}
		exit(errors > 0)
	}
' "$root/code.wat"

awk '
	$0 !~ /\(global \$state_/ {
		line = $0
		while (match(line, /i32\.const (1024|1028|1032|1040|1048|1056|1064|1072|1080|1088|1096|1100|1104|1108|1112|1116|1120|1124|1128|1132|1136|1144|1152) (i32\.(load|store)|i64\.(load|store)|global\.get \$state_)/)) {
			printf "raw scalar-state address at line %d: %s\n", NR, substr(line, RSTART, RLENGTH) > "/dev/stderr"
			errors++
			line = substr(line, RSTART + RLENGTH)
		}
	}
	END { exit(errors > 0) }
' "$root/code.wat"

awk '
	/i32\.const 1108/ { flag_address_literals++ }
	/i32\.const (-16|-129|-257|528|656)([^0-9]|$)/ && $0 !~ /\(global \$flag_/ {
		printf "opaque flag composite at line %d: %s\n", NR, $0 > "/dev/stderr"
		errors++
	}
	END {
		if (flag_address_literals != 1) {
			printf "expected one named flags-address declaration, found %d raw literals\n", flag_address_literals > "/dev/stderr"
			errors++
		}
		exit(errors > 0)
	}
' "$root/code.wat"
