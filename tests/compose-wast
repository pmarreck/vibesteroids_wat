#!/usr/bin/env bash

set -u

root=${VIBESTEROIDS_WAT_ROOT:-$(cd "$(dirname "$0")/.." && pwd -P)}

# Emits one portable standard-WAST application suite. Production rate variants
# are generated from the same WAT bytes so equal-time behavior stays falsifiable.
append_rate_variant() {
	local label=$1
	local numerator=$2
	local denominator=$3

	awk -v numerator="$numerator" -v denominator="$denominator" '
		$0 ~ /^\t\(global \$tick_numerator i64 \(i64.const [0-9]+\)\)$/ {
			print "\t(global $tick_numerator i64 (i64.const " numerator "))"
			next
		}
		$0 ~ /^\t\(global \$tick_denominator i64 \(i64.const [0-9]+\)\)$/ {
			print "\t(global $tick_denominator i64 (i64.const " denominator "))"
			next
		}
		{ print }
	' "$root/code.wat"
	status=$?
	if (( status != 0 )); then
		return "$status"
	fi
	printf '(register "%s")\n' "$label"
}

awk '1' "$root/tests/wast/aedicule-v0.wast" "$root/code.wat"
status=$?
if (( status != 0 )); then
	exit "$status"
fi

printf '%s\n' '(register "sut")'
status=$?
if (( status != 0 )); then
	exit "$status"
fi

for variant in \
	'sut_60 60 1' \
	'sut_120 120 1' \
	'sut_60000_1001 60000 1001' \
	'sut_120000_1001 120000 1001'; do
	read -r label numerator denominator <<<"$variant"
	append_rate_variant "$label" "$numerator" "$denominator"
	status=$?
	if (( status != 0 )); then
		exit "$status"
	fi
done

awk '1' \
	"$root/tests/wast/aedicule-contract.wast" \
	"$root/tests/wast/vibesteroids.wast" \
	"$root/tests/wast/gameplay.wast" \
	"$root/tests/wast/enemy-and-powerup.wast" \
	"$root/tests/wast/satellite.wast" \
	"$root/tests/wast/rational-timing.wast" \
	"$root/tests/wast/equal-time.wast"
