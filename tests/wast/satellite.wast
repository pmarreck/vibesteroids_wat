;; Voyager has its own deterministic 45--120-second schedule and seeded signs.
(assert_return
	(invoke $vibesteroids_tests "spawn_schedules_within"
		(i32.const 5400) (i32.const 14400) (i32.const 64))
	(i32.const 1))
(assert_return
	(invoke $vibesteroids_tests "satellite_entries_valid" (i32.const 64))
	(i32.const 1))

;; A due appearance remains pending at the threshold, then enters as soon as
;; the active asteroid set falls below fifteen. This is deliberately not a
;; once-per-level gate.
(assert_return (invoke $vibesteroids_tests "reset") (i32.const 0))
(assert_return (invoke $vibesteroids_tests "clear_active" (i32.const 3328) (i32.const 80) (i32.const 32)))
(assert_return (invoke $vibesteroids_tests "fill_active" (i32.const 3328) (i32.const 80) (i32.const 15)))
(assert_return (invoke $vibesteroids_tests "state_set_i32" (i32.const 25708) (i32.const 1)))
(assert_return (invoke $vibesteroids_tests "tick" (i32.const 1)) (i32.const 0))
(assert_return (invoke $vibesteroids_tests "state_i32" (i32.const 25632)) (i32.const 0))
(assert_return (invoke $vibesteroids_tests "state_i32" (i32.const 25708)) (i32.const 0))
(assert_return (invoke $vibesteroids_tests "clear_active" (i32.const 3328) (i32.const 80) (i32.const 32)))
(assert_return (invoke $vibesteroids_tests "fill_active" (i32.const 3328) (i32.const 80) (i32.const 14)))
(assert_return (invoke $vibesteroids_tests "tick" (i32.const 1)) (i32.const 0))
(assert_return (invoke $vibesteroids_tests "state_i32" (i32.const 25632)) (i32.const 1))

;; Existing foreign actors do not suppress Voyager, and its appearance has no
;; notification cue. The first faint phone-home ping is intentionally delayed.
(assert_return (invoke $vibesteroids_tests "reset") (i32.const 0))
(assert_return (invoke $vibesteroids_tests "clear_active" (i32.const 3328) (i32.const 80) (i32.const 32)))
(assert_return (invoke $vibesteroids_tests "state_set_i32" (i32.const 15008) (i32.const 1)))
(assert_return (invoke $vibesteroids_tests "state_set_i64" (i32.const 15016) (i64.const 900000000)))
(assert_return (invoke $vibesteroids_tests "state_set_i64" (i32.const 15024) (i64.const 700000000)))
(assert_return (invoke $vibesteroids_tests "state_set_i32" (i32.const 15048) (i32.const 1000)))
(assert_return (invoke $vibesteroids_tests "state_set_i32" (i32.const 15440) (i32.const 1)))
(assert_return (invoke $vibesteroids_tests "state_set_i64" (i32.const 15448) (i64.const 900000000)))
(assert_return (invoke $vibesteroids_tests "state_set_i64" (i32.const 15456) (i64.const 700000000)))
(assert_return (invoke $vibesteroids_tests "state_set_i32" (i32.const 25708) (i32.const 1)))
(assert_return (invoke $vibesteroids_tests "host_reset_effects"))
(assert_return (invoke $vibesteroids_tests "tick" (i32.const 1)) (i32.const 0))
(assert_return (invoke $vibesteroids_tests "state_i32" (i32.const 15008)) (i32.const 1))
(assert_return (invoke $vibesteroids_tests "state_i32" (i32.const 15440)) (i32.const 1))
(assert_return (invoke $vibesteroids_tests "state_i32" (i32.const 25632)) (i32.const 1))
(assert_return (invoke $vibesteroids_tests "host_audio_seen" (i32.const 13)) (i32.const 0))

;; Slow rotation honors either seeded sign, the glow phase advances on the
;; fixed clock, and the first phone-home ping restarts a three-second cadence.
(assert_return (invoke $vibesteroids_tests "reset") (i32.const 0))
(assert_return (invoke $vibesteroids_tests "state_set_i32" (i32.const 25632) (i32.const 1)))
(assert_return (invoke $vibesteroids_tests "state_set_i64" (i32.const 25640) (i64.const 400000000)))
(assert_return (invoke $vibesteroids_tests "state_set_i64" (i32.const 25648) (i64.const 200000000)))
(assert_return (invoke $vibesteroids_tests "state_set_i64" (i32.const 25672) (i64.const 1000000)))
(assert_return (invoke $vibesteroids_tests "state_set_i64" (i32.const 25680) (i64.const 0)))
(assert_return (invoke $vibesteroids_tests "state_set_i32" (i32.const 25696) (i32.const 1)))
(assert_return (invoke $vibesteroids_tests "state_set_i32" (i32.const 25700) (i32.const 1)))
(assert_return (invoke $vibesteroids_tests "host_reset_effects"))
(assert_return (invoke $vibesteroids_tests "raw_tick" (i32.const 1)) (i32.const 0))
(assert_return (invoke $vibesteroids_tests "state_i64_positive" (i32.const 25680)) (i32.const 1))
(assert_return (invoke $vibesteroids_tests "state_i32" (i32.const 25704)) (i32.const 1))
(assert_return (invoke $vibesteroids_tests "state_i32" (i32.const 25700)) (i32.const 360))
(assert_return (invoke $vibesteroids_tests "host_audio_seen" (i32.const 13)) (i32.const 1))

(assert_return (invoke $vibesteroids_tests "state_set_i64" (i32.const 25672) (i64.const 1000000)))
(assert_return (invoke $vibesteroids_tests "state_set_i64" (i32.const 25680) (i64.const 0)))
(assert_return (invoke $vibesteroids_tests "state_set_i32" (i32.const 25696) (i32.const -1)))
(assert_return (invoke $vibesteroids_tests "raw_tick" (i32.const 1)) (i32.const 0))
(assert_return (invoke $vibesteroids_tests "state_i64_negative" (i32.const 25680)) (i32.const 1))

;; A player bullet gives the reactor blast score attribution but no intrinsic
;; satellite bounty. The doubled blast clears two terminal rocks in one strategic
;; shot, including one 230 pixels away; a rock beyond radius + hull survives.
(assert_return (invoke $vibesteroids_tests "reset") (i32.const 0))
(assert_return (invoke $vibesteroids_tests "clear_active" (i32.const 3328) (i32.const 80) (i32.const 32)))
(assert_return (invoke $vibesteroids_tests "state_set_i32" (i32.const 3328) (i32.const 1)))
(assert_return (invoke $vibesteroids_tests "state_set_i64" (i32.const 3344) (i64.const 250000000)))
(assert_return (invoke $vibesteroids_tests "state_set_i64" (i32.const 3352) (i64.const 200000000)))
(assert_return (invoke $vibesteroids_tests "state_set_i64" (i32.const 3376) (i64.const 20000000)))
(assert_return (invoke $vibesteroids_tests "state_set_i32" (i32.const 3408) (i32.const 1)))
(assert_return (invoke $vibesteroids_tests "state_set_i64" (i32.const 3424) (i64.const 430000000)))
(assert_return (invoke $vibesteroids_tests "state_set_i64" (i32.const 3432) (i64.const 200000000)))
(assert_return (invoke $vibesteroids_tests "state_set_i64" (i32.const 3456) (i64.const 20000000)))
(assert_return (invoke $vibesteroids_tests "state_set_i32" (i32.const 3488) (i32.const 1)))
(assert_return (invoke $vibesteroids_tests "state_set_i64" (i32.const 3504) (i64.const 470000000)))
(assert_return (invoke $vibesteroids_tests "state_set_i64" (i32.const 3512) (i64.const 200000000)))
(assert_return (invoke $vibesteroids_tests "state_set_i64" (i32.const 3536) (i64.const 20000000)))
(assert_return (invoke $vibesteroids_tests "state_set_i32" (i32.const 25632) (i32.const 1)))
(assert_return (invoke $vibesteroids_tests "state_set_i64" (i32.const 25640) (i64.const 200000000)))
(assert_return (invoke $vibesteroids_tests "state_set_i64" (i32.const 25648) (i64.const 200000000)))
(assert_return (invoke $vibesteroids_tests "state_set_i64" (i32.const 25688) (i64.const 60000000)))
(assert_return (invoke $vibesteroids_tests "state_set_i32" (i32.const 25700) (i32.const 1000)))
(assert_return (invoke $vibesteroids_tests "state_set_i32" (i32.const 256) (i32.const 1)))
(assert_return (invoke $vibesteroids_tests "state_set_i64" (i32.const 264) (i64.const 200000000)))
(assert_return (invoke $vibesteroids_tests "state_set_i64" (i32.const 272) (i64.const 200000000)))
(assert_return (invoke $vibesteroids_tests "host_reset_effects"))
(assert_return (invoke $vibesteroids_tests "raw_tick" (i32.const 1)) (i32.const 0))
(assert_return (invoke $vibesteroids_tests "state_i32" (i32.const 25632)) (i32.const 0))
(assert_return (invoke $vibesteroids_tests "state_i32" (i32.const 25600)) (i32.const 1))
(assert_return (invoke $vibesteroids_tests "state_i32" (i32.const 25604)) (i32.const 1))
(assert_return (invoke $vibesteroids_tests "state_i32" (i32.const 3328)) (i32.const 0))
(assert_return (invoke $vibesteroids_tests "state_i32" (i32.const 3408)) (i32.const 0))
(assert_return (invoke $vibesteroids_tests "state_i32" (i32.const 3488)) (i32.const 1))
(assert_return (invoke $vibesteroids_tests "state_i32" (i32.const 72)) (i32.const 240))
;; The quote is a deferred playback event, not part of the blast program: it
;; fires exactly one simulated second after player attribution is established.
(assert_return (invoke $vibesteroids_tests "state_i32" (i32.const 25712)) (i32.const 120))
(assert_return (invoke $vibesteroids_tests "host_audio_seen" (i32.const 14)) (i32.const 0))
(assert_return (invoke $vibesteroids_tests "host_sample_play_count") (i32.const 0))
(assert_return (invoke $vibesteroids_tests "raw_tick" (i32.const 119)) (i32.const 0))
(assert_return (invoke $vibesteroids_tests "state_i32" (i32.const 25712)) (i32.const 1))
(assert_return (invoke $vibesteroids_tests "host_audio_seen" (i32.const 14)) (i32.const 0))
(assert_return (invoke $vibesteroids_tests "host_sample_play_count") (i32.const 0))
(assert_return (invoke $vibesteroids_tests "raw_tick" (i32.const 1)) (i32.const 0))
(assert_return (invoke $vibesteroids_tests "state_i32" (i32.const 25712)) (i32.const 0))
(assert_return (invoke $vibesteroids_tests "host_audio_seen" (i32.const 14)) (i32.const 0))
(assert_return (invoke $vibesteroids_tests "host_sample_play_count") (i32.const 1))
(assert_return (invoke $vibesteroids_tests "host_sample_play_valid") (i32.const 1))

;; Peter-approved production geometry keeps both bent boom rails connected and
;; compresses the original concept to an approximately 136x47-pixel footprint.
(assert_return (invoke $vibesteroids_tests "reset") (i32.const 0))
(assert_return (invoke $vibesteroids_tests "state_set_i32" (i32.const 25632) (i32.const 1)))
(assert_return (invoke $vibesteroids_tests "state_set_i64" (i32.const 25640) (i64.const 400000000)))
(assert_return (invoke $vibesteroids_tests "state_set_i64" (i32.const 25648) (i64.const 300000000)))
(assert_return (invoke $vibesteroids_tests "state_set_i64" (i32.const 25672) (i64.const 1000000)))
(assert_return (invoke $vibesteroids_tests "state_set_i64" (i32.const 25680) (i64.const 0)))
(assert_return (invoke $vibesteroids_tests "state_set_i32" (i32.const 25704) (i32.const 0)))
(assert_return (invoke $vibesteroids_tests "host_reset_frame"))
(assert_return (invoke $vibesteroids_tests "render") (i32.const 0))
(assert_return (invoke $vibesteroids_tests "host_satellite_paths") (i32.const 12))
(assert_return (invoke $vibesteroids_tests "host_satellite_lines") (i32.const 3))
(assert_return (invoke $vibesteroids_tests "host_satellite_circles") (i32.const 8))
(assert_return (invoke $vibesteroids_tests "host_satellite_connected_booms") (i32.const 2))
(assert_return (invoke $vibesteroids_tests "host_satellite_footprint_valid") (i32.const 1))
(assert_return (invoke $vibesteroids_tests "host_satellite_glow_radius") (f32.const 52))

;; The pulse is subtle and render-pure: the same explicit phase always yields
;; the same four-pixel expansion without reading a clock or mutating state.
(assert_return (invoke $vibesteroids_tests "state_set_i32" (i32.const 25704) (i32.const 120)))
(assert_return (invoke $vibesteroids_tests "host_reset_frame"))
(assert_return (invoke $vibesteroids_tests "render") (i32.const 0))
(assert_return (invoke $vibesteroids_tests "host_satellite_glow_radius") (f32.const 56))
(assert_return (invoke $vibesteroids_tests "state_i32_between" (i32.const 25708) (i32.const 5400) (i32.const 14400)) (i32.const 1))
(assert_return (invoke $vibesteroids_tests "host_audio_seen" (i32.const 12)) (i32.const 1))

;; Physical asteroid contact detonates the same blast but cannot manufacture
;; score, even when the impact destroys more than one rock.
(assert_return (invoke $vibesteroids_tests "reset") (i32.const 0))
(assert_return (invoke $vibesteroids_tests "clear_active" (i32.const 3328) (i32.const 80) (i32.const 32)))
(assert_return (invoke $vibesteroids_tests "state_set_i32" (i32.const 3328) (i32.const 1)))
(assert_return (invoke $vibesteroids_tests "state_set_i64" (i32.const 3344) (i64.const 200000000)))
(assert_return (invoke $vibesteroids_tests "state_set_i64" (i32.const 3352) (i64.const 200000000)))
(assert_return (invoke $vibesteroids_tests "state_set_i64" (i32.const 3376) (i64.const 20000000)))
(assert_return (invoke $vibesteroids_tests "state_set_i32" (i32.const 3408) (i32.const 1)))
(assert_return (invoke $vibesteroids_tests "state_set_i64" (i32.const 3424) (i64.const 250000000)))
(assert_return (invoke $vibesteroids_tests "state_set_i64" (i32.const 3432) (i64.const 200000000)))
(assert_return (invoke $vibesteroids_tests "state_set_i64" (i32.const 3456) (i64.const 20000000)))
(assert_return (invoke $vibesteroids_tests "state_set_i32" (i32.const 3488) (i32.const 1)))
(assert_return (invoke $vibesteroids_tests "state_set_i64" (i32.const 3504) (i64.const 900000000)))
(assert_return (invoke $vibesteroids_tests "state_set_i64" (i32.const 3512) (i64.const 700000000)))
(assert_return (invoke $vibesteroids_tests "state_set_i64" (i32.const 3536) (i64.const 20000000)))
(assert_return (invoke $vibesteroids_tests "state_set_i32" (i32.const 25632) (i32.const 1)))
(assert_return (invoke $vibesteroids_tests "state_set_i64" (i32.const 25640) (i64.const 200000000)))
(assert_return (invoke $vibesteroids_tests "state_set_i64" (i32.const 25648) (i64.const 200000000)))
(assert_return (invoke $vibesteroids_tests "state_set_i64" (i32.const 25688) (i64.const 60000000)))
(assert_return (invoke $vibesteroids_tests "state_set_i32" (i32.const 25700) (i32.const 1000)))
(assert_return (invoke $vibesteroids_tests "host_reset_effects"))
(assert_return (invoke $vibesteroids_tests "raw_tick" (i32.const 1)) (i32.const 0))
(assert_return (invoke $vibesteroids_tests "state_i32" (i32.const 25632)) (i32.const 0))
(assert_return (invoke $vibesteroids_tests "state_i32" (i32.const 25600)) (i32.const 1))
(assert_return (invoke $vibesteroids_tests "state_i32" (i32.const 25604)) (i32.const 0))
(assert_return (invoke $vibesteroids_tests "state_i32" (i32.const 3328)) (i32.const 0))
(assert_return (invoke $vibesteroids_tests "state_i32" (i32.const 3408)) (i32.const 0))
(assert_return (invoke $vibesteroids_tests "state_i32" (i32.const 3488)) (i32.const 1))
(assert_return (invoke $vibesteroids_tests "state_i32" (i32.const 72)) (i32.const 0))
(assert_return (invoke $vibesteroids_tests "state_i32" (i32.const 25712)) (i32.const 0))
(assert_return (invoke $vibesteroids_tests "raw_tick" (i32.const 120)) (i32.const 0))
(assert_return (invoke $vibesteroids_tests "host_audio_seen" (i32.const 14)) (i32.const 0))
(assert_return (invoke $vibesteroids_tests "host_sample_play_count") (i32.const 0))

;; Laser fire is still player fire: a finite beam may deliberately trigger the
;; reactor and attributes collateral asteroid points to the player.
(assert_return (invoke $vibesteroids_tests "reset") (i32.const 0))
(assert_return (invoke $vibesteroids_tests "clear_active" (i32.const 3328) (i32.const 80) (i32.const 32)))
(assert_return (invoke $vibesteroids_tests "state_set_i64" (i32.const 24) (i64.const 100000000)))
(assert_return (invoke $vibesteroids_tests "state_set_i64" (i32.const 32) (i64.const 200000000)))
(assert_return (invoke $vibesteroids_tests "state_set_i64" (i32.const 56) (i64.const 1000000)))
(assert_return (invoke $vibesteroids_tests "state_set_i64" (i32.const 64) (i64.const 0)))
(assert_return (invoke $vibesteroids_tests "state_set_i32" (i32.const 3328) (i32.const 1)))
(assert_return (invoke $vibesteroids_tests "state_set_i64" (i32.const 3344) (i64.const 350000000)))
(assert_return (invoke $vibesteroids_tests "state_set_i64" (i32.const 3352) (i64.const 260000000)))
(assert_return (invoke $vibesteroids_tests "state_set_i64" (i32.const 3376) (i64.const 20000000)))
(assert_return (invoke $vibesteroids_tests "state_set_i32" (i32.const 3408) (i32.const 1)))
(assert_return (invoke $vibesteroids_tests "state_set_i64" (i32.const 3424) (i64.const 900000000)))
(assert_return (invoke $vibesteroids_tests "state_set_i64" (i32.const 3432) (i64.const 700000000)))
(assert_return (invoke $vibesteroids_tests "state_set_i64" (i32.const 3456) (i64.const 20000000)))
(assert_return (invoke $vibesteroids_tests "state_set_i32" (i32.const 25632) (i32.const 1)))
(assert_return (invoke $vibesteroids_tests "state_set_i64" (i32.const 25640) (i64.const 300000000)))
(assert_return (invoke $vibesteroids_tests "state_set_i64" (i32.const 25648) (i64.const 200000000)))
(assert_return (invoke $vibesteroids_tests "state_set_i64" (i32.const 25688) (i64.const 60000000)))
(assert_return (invoke $vibesteroids_tests "state_set_i32" (i32.const 25700) (i32.const 1000)))
(assert_return (invoke $vibesteroids_tests "state_set_i32" (i32.const 15496) (i32.const 2400)))
(assert_return (invoke $vibesteroids_tests "event" (i32.const 1) (i32.const 4)) (i32.const 0))
(assert_return (invoke $vibesteroids_tests "raw_tick" (i32.const 1)) (i32.const 0))
(assert_return (invoke $vibesteroids_tests "state_i32" (i32.const 25632)) (i32.const 0))
(assert_return (invoke $vibesteroids_tests "state_i32" (i32.const 3328)) (i32.const 0))
(assert_return (invoke $vibesteroids_tests "state_i32" (i32.const 3408)) (i32.const 1))
(assert_return (invoke $vibesteroids_tests "state_i32" (i32.const 72)) (i32.const 120))
(assert_return (invoke $vibesteroids_tests "state_i32" (i32.const 25712)) (i32.const 120))
