#!/usr/bin/env bash

set -u

# shellcheck source=/dev/null
source "$HOME/dotfiles/bin/src/capture.bash"

system=$(nix eval --impure --raw --expr builtins.currentSystem 2>"$TMPDIR/vibesteroids-runtime-system.err")
status=$?
if (( status != 0 )); then
	printf 'could not determine the current Nix system\n' >&2
	exit 1
fi

out=
err=
rc=0
capture nix build --no-link ".#checks.$system.runtime"
if (( rc != 0 )); then
	if [[ -n $out ]]; then
		printf '%s\n' "$out" >&2
	fi
	printf '%s\n' "$err" >&2
	exit 1
fi
