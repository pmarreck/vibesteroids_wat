#!/usr/bin/env bash

set -u

diagnostics=$(mktemp -d "$TMPDIR/vibesteroids-runtime.XXXXXX")
trap 'rm -rf "$diagnostics"' EXIT

system=$(nix eval --impure --raw --expr builtins.currentSystem 2>"$diagnostics/system.stderr")
status=$?
if (( status != 0 )); then
	printf 'could not determine the current Nix system\n' >&2
	if [[ -s $diagnostics/system.stderr ]]; then
		cat "$diagnostics/system.stderr" >&2
	fi
	exit 1
fi

nix build --no-link ".#checks.$system.runtime" \
	>"$diagnostics/build.stdout" 2>"$diagnostics/build.stderr"
status=$?
if (( status != 0 )); then
	if [[ -s $diagnostics/build.stdout ]]; then
		cat "$diagnostics/build.stdout" >&2
	fi
	if [[ -s $diagnostics/build.stderr ]]; then
		cat "$diagnostics/build.stderr" >&2
	fi
	exit 1
fi
