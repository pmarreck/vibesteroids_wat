#!/usr/bin/env bash

set -u

root=$(cd "$(dirname "$0")/../.." && pwd)
specification="$root/SPEC.md"
contract_phrases=(
	'aedicule.v0'
	'AE_event(kind, code, a, b)'
	'AE_tick_rate(current_numerator, current_denominator) -> (120, 1)'
	'Schema 9 is 32,768 bytes.'
	'code = refresh_numerator_hz'
)
stale_snapshot_phrases=(
	'8192 bytes'
	'8192-byte snapshot'
)
failures=0

for phrase in "${contract_phrases[@]}"; do
	if ! rg --fixed-strings --quiet "$phrase" "$specification"; then
		printf 'Aedicule ABI contract phrase is absent: %s\n' "$phrase" >&2
		failures=$((failures + 1))
	fi
done

for phrase in "${stale_snapshot_phrases[@]}"; do
	if rg --fixed-strings --quiet "$phrase" "$specification"; then
		printf 'stale snapshot contract phrase remains: %s\n' "$phrase" >&2
		failures=$((failures + 1))
	fi
done

exit "$failures"
