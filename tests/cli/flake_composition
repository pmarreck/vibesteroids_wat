#!/usr/bin/env bash

set -u

failures=0
system=$(nix eval --impure --raw --expr builtins.currentSystem 2>"$TMPDIR/vibesteroids-system.err")
status=$?
if (( status != 0 )); then
	exit 1
fi

application_drv=$(nix eval --raw ".#packages.$system.application.drvPath" 2>"$TMPDIR/vibesteroids-application.err")
status=$?
if (( status != 0 )); then
	failures=$((failures + 1))
fi

frontplane_drv=$(nix eval --raw ".#packages.$system.frontplane.drvPath" 2>"$TMPDIR/vibesteroids-frontplane.err")
status=$?
if (( status != 0 )); then
	failures=$((failures + 1))
fi

default_drv=$(nix eval --raw ".#packages.$system.default.drvPath" 2>"$TMPDIR/vibesteroids-default.err")
status=$?
if (( status != 0 )); then
	failures=$((failures + 1))
elif [[ "$default_drv" == "$application_drv" || "$default_drv" == "$frontplane_drv" ]]; then
	printf 'default package must compose distinct application and frontplane derivations\n' >&2
	failures=$((failures + 1))
else
	references=$(nix-store --query --references "$default_drv")
	status=$?
	if (( status != 0 )); then
		failures=$((failures + 1))
	else
		for dependency in "$application_drv" "$frontplane_drv"; do
			if ! rg --fixed-strings --quiet "$dependency" <<<"$references"; then
				printf 'default package does not reference required derivation: %s\n' "$dependency" >&2
				failures=$((failures + 1))
			fi
		done
	fi
fi

exit "$failures"
